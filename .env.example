# Copy this file to .env and fill only the services you use. Never commit .env.
HF_TOKEN=

# Optional ClearML server credentials. Run `uv run clearml-init` to configure them
# interactively, or provide the values through the environment.
CLEARML_API_HOST=https://api.clear.ml
CLEARML_WEB_HOST=https://app.clear.ml
CLEARML_FILES_HOST=https://files.clear.ml
CLEARML_API_ACCESS_KEY=
CLEARML_API_SECRET_KEY=

# Useful deterministic defaults for experiments.
PYTHONHASHSEED=0
TOKENIZERS_PARALLELISM=false

